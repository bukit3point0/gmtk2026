[node name="RichTextLabel" type="RichTextLabel" parent="Pages/Lightbulbs/Page2" unique_id=492020263]
offset_left = -293.0
offset_top = -166.0
offset_right = -1.0
offset_bottom = 147.0
theme_override_colors/default_color = Color(0.07058824, 0.07058824, 0.07058824, 1)
theme_override_font_sizes/normal_font_size = 20
text = "Step 1: Begin with all switch protocols in the off position. If any switch has been left in the off position, there may be systems firing that may prevent test mode from functioning. (The Reset Protocol must be completed prior to engaging Test Mode). If all switches are in the correct configuration proceed to Step 2."

[node name="RichTextLabel2" type="RichTextLabel" parent="Pages/Lightbulbs/Page2" unique_id=1215928935]
offset_left = 13.0
offset_top = -181.0
offset_right = 304.99997
offset_bottom = 147.0
theme_override_colors/default_color = Color(0.07058824, 0.07058824, 0.07058824, 1)
theme_override_font_sizes/normal_font_size = 20
text = "Step 2: Cycle the Navigation System Control (NSc1) Switch located at Toggle Switch 5. This will cycle through all navigation control systems to verify they are freely moving. Begin the cycling process by switching the toggle on and off quickly three times ending with the toggle in the on position the third time. The cycle may take up to 3 seconds to complete: 
	a. PASS - the light above the toggle remains solid. Proceed to Step 3.
	b. PASS - If the light is blinking slowly, this indicates a moving part is sticking but tested successfully.  All moving parts should be lubricated following the shuttle’s return.
	c. WARNING - If the light is blinking slowly, “Warning - Ports 3 and 4 have been labeled incorrectly please swap the labels. The pilot will need to compensate by reversing Y Axis controls.” Proceed to Step 3."

[node name="NextPageButton" type="Button" parent="Pages/Lightbulbs/Page2" unique_id=1272243894]
offset_left = 186.0
offset_top = 146.0
offset_right = 298.0
offset_bottom = 181.0
theme_override_font_sizes/font_size = 20
text = "Next Page"
icon = SubResource("CompressedTexture2D_nvh1c")
expand_icon = true

[node name="Page3" type="Node2D" parent="Pages/Lightbulbs" unique_id=36001933]
visible = false

[node name="LastPageButton" type="Button" parent="Pages/Lightbulbs/Page3" unique_id=346912568]
offset_left = -296.0
offset_top = 144.0
offset_right = -184.0
offset_bottom = 179.0
theme_override_font_sizes/font_size = 20
text = "Last Page"
icon = ExtResource("8_6bl1r")
expand_icon = true

[node name="RichTextLabel" type="RichTextLabel" parent="Pages/Lightbulbs/Page3" unique_id=1748354744]
offset_left = -293.0
offset_top = -173.0
offset_right = -1.0
offset_bottom = 147.0
theme_override_colors/default_color = Color(0.07058824, 0.07058824, 0.07058824, 1)
theme_override_font_sizes/normal_font_size = 20
text = "Step 3: Toggle the External Sensor Array Switch (EsA3) located at Toggle Switch 3 to the on position.
	a. PASS - The temperature gage will raise to maximum for 3 Seconds then should remain within [8 to 10] go to Step 4
	b. CRITICAL - The temperature gage does go to maximum prior to becoming steady. ABORT!
	c. WARNING - the temperature gage goes to maximum and remains mostly steady but occasionally dips below [8]. “Warning - Fuel pipe in contact with a Structural  Member” go to Step 4"

[node name="RichTextLabel2" type="RichTextLabel" parent="Pages/Lightbulbs/Page3" unique_id=1715747468]
offset_left = 13.0
offset_top = -177.0
offset_right = 304.99997
offset_bottom = 181.0
theme_override_colors/default_color = Color(0.07058824, 0.07058824, 0.07058824, 1)
theme_override_font_sizes/normal_font_size = 20
text = "Step 4: Finally, engage test mode by doing the following in order:
	1. Turn the Auxiliary System Controller Switch (ASc1) to the on position.
	2. Quickly turn on the Primary Communications Sync (Pcs2), and quickly turn it off again. The second indicator light will blink twice.
	3. Turn on the Primary Control System (PcS2).
		a. CRITICAL - Light 3 is blinking, light 2 or 5 is solid, and light one is not lit.
		b.CRITICAL - Any two lights are solid and any two lights are blinking.
		c. CRITICAL - Any three lights are blinking and there is one solid light.
		4. WARNING - Light 1 and light 5 are both solid “Warning the fuel tank is in contact with a deck plate.”
		5. PASS - All other configurations. You may proceed"

