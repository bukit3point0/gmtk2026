theme_override_colors/default_color = Color(0, 0, 0, 1)
theme_override_font_sizes/normal_font_size = 14
text = "Reactivity of components in continuous contact must NOT exceed 0.5 units, otherwise operational conditions may result in structural failure.

Aluminum	-0.8
Brass		 0.3
Copper	 	 0.2
Iron		-0.4
Magnesium	-1.1
Nickel		-0.3
Steel		-0.1
Titanium	 0.4
Zinc		-0.7"

